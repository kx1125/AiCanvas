#pragma kernel ImportImage
#pragma kernel EncodeImage
#pragma kernel PreviewChannel

Texture2D<float4> _Input;
RWTexture2D<float4> _Output;
int _Width;
int _Height;
int _DecodeSrgb;
int _EncodeSrgb;
int _PreviewChannel;

float3 DecodeSrgb(float3 value)
{
    return lerp(value / 12.92, pow(max((value + 0.055) / 1.055, 0.0), 2.4), step(0.04045, value));
}

float3 EncodeSrgb(float3 value)
{
    value = max(value, 0.0);
    return lerp(value * 12.92, 1.055 * pow(value, 1.0 / 2.4) - 0.055, step(0.0031308, value));
}

[numthreads(8, 8, 1)]
void ImportImage(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    float4 value = _Input.Load(int3(id.xy, 0));
    if (_DecodeSrgb != 0) value.rgb = DecodeSrgb(value.rgb);
    _Output[id.xy] = value;
}

[numthreads(8, 8, 1)]
void EncodeImage(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    float4 value = _Input.Load(int3(id.xy, 0));
    if (_EncodeSrgb != 0) value.rgb = EncodeSrgb(value.rgb);
    _Output[id.xy] = saturate(value);
}

[numthreads(8, 8, 1)]
void PreviewChannel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    float4 value = _Input.Load(int3(id.xy, 0));
    if (_DecodeSrgb != 0) value.rgb = DecodeSrgb(value.rgb);
    float gray = value[_PreviewChannel];
    // Single channels are opaque so RGB remains inspectable even where the source alpha is zero.
    _Output[id.xy] = float4(gray, gray, gray, 1.0);
}
