#pragma kernel ClearHistogram
#pragma kernel CountHistogram

Texture2D<float4> _Input;
RWStructuredBuffer<uint> _Bins;
int _SampleWidth, _SampleHeight;
int _EncodeSrgb;
// Four contiguous 256-bin channels: R, G, B, luminance.
groupshared uint localBins[1024];

float3 HistogramEncodeSrgb(float3 value)
{
    value = max(value, 0.0);
    return lerp(value * 12.92, 1.055 * pow(value, 1.0 / 2.4) - 0.055, step(0.0031308, value));
}

[numthreads(256, 1, 1)]
void ClearHistogram(uint3 id : SV_DispatchThreadID)
{
    _Bins[id.x] = 0;
    _Bins[id.x + 256] = 0;
    _Bins[id.x + 512] = 0;
    _Bins[id.x + 768] = 0;
}

[numthreads(16, 16, 1)]
void CountHistogram(uint3 id : SV_DispatchThreadID, uint index : SV_GroupIndex)
{
    localBins[index] = localBins[index + 256] = localBins[index + 512] = localBins[index + 768] = 0;
    GroupMemoryBarrierWithGroupSync();
    if (id.x < (uint)_SampleWidth && id.y < (uint)_SampleHeight)
    {
        uint width, height;
        _Input.GetDimensions(width, height);
        // Stratified point samples preserve the source distribution; no bilinear averaging.
        uint2 pixel = min((uint2)((float2(id.xy) + 0.5) * float2(width, height) /
            float2(_SampleWidth, _SampleHeight)), uint2(width - 1, height - 1));
        float3 value = _Input.Load(int3(pixel, 0)).rgb;
        // Convert each channel BEFORE luminance weighting and binning, as used by Levels.
        if (_EncodeSrgb != 0) value = HistogramEncodeSrgb(value);
        // Non-finite samples do not have a meaningful location in a finite histogram.
        if (isfinite(value.r)) InterlockedAdd(localBins[min((uint)(saturate(value.r) * 256), 255)], 1);
        if (isfinite(value.g)) InterlockedAdd(localBins[256 + min((uint)(saturate(value.g) * 256), 255)], 1);
        if (isfinite(value.b)) InterlockedAdd(localBins[512 + min((uint)(saturate(value.b) * 256), 255)], 1);
        // Unity RGB luminance weights, applied in the selected working space before clamping.
        float luminance = dot(value, float3(0.2126729, 0.7151522, 0.0721750));
        if (isfinite(luminance)) InterlockedAdd(localBins[768 + min((uint)(saturate(luminance) * 256), 255)], 1);
    }
    GroupMemoryBarrierWithGroupSync();
    // Aggregate per group to reduce contention for uniform images.
    for (uint channel = 0; channel < 4; channel++)
    {
        uint bin = index + channel * 256;
        if (localBins[bin] != 0) InterlockedAdd(_Bins[bin], localBins[bin]);
    }
}
